# Copy this file to .env and replace the placeholders locally.
POSTGRES_DB=ciclosec
POSTGRES_USER=ciclosec
POSTGRES_PASSWORD=replace-with-a-local-only-password
CICLOSEC_POSTGRES_PORT=5433
CICLOSEC_REDIS_PORT=6380
CICLOSEC_WEB_PORT=8000
CICLOSEC_DATABASE_URL=postgresql://ciclosec:${POSTGRES_PASSWORD}@127.0.0.1:${CICLOSEC_POSTGRES_PORT}/ciclosec
CICLOSEC_REDIS_URL=redis://localhost:${CICLOSEC_REDIS_PORT}/0
CICLOSEC_DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
